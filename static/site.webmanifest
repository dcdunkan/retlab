{
	"$schema": "https://json.schemastore.org/web-manifest.json",
	"name": "Retlab",
	"short_name": "ret",
	"description": "Etlab sucks. But Retlab tries not to. Retlab is an alternative frontend for the Etlab with some tweaks.",
	"categories": ["education", "productivity", "utilities"],
	"icons": [
		{
			"src": "/web-app-manifest-192x192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "/web-app-manifest-512x512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"start_url": "/",
	"theme_color": "#131313",
	"background_color": "#131313",
	"display": "standalone",
	"shortcuts": [
		{
			"name": "Attendance",
			"short_name": "Attendance",
			"description": "View attendance calendar & by subject",
			"url": "/attendance"
		},
		{
			"name": "Assignments",
			"short_name": "Assignments",
			"description": "View assignments",
			"url": "/assignments"
		},
		{
			"name": "Results",
			"short_name": "Results",
			"description": "View sessional & internal results",
			"url": "/results"
		},
		{
			"name": "Settings",
			"short_name": "Settings",
			"description": "Tweaks and other settings",
			"url": "/settings"
		}
	]
}
